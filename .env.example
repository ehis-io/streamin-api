# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add import "dotenv/config"; to your prisma.config.ts file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following prisma+postgres URL is similar to the URL produced by running a local Prisma Postgres
# server with the prisma dev CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL=mongodb+srv://<username>:<password>@nexus.n7vfyxt.mongodb.net/nexus
TMDB_API_KEY=<tmdb_api_key>
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=4001
GEMINI_API_KEY=gemini_api_key_here

# Subtitles (Wyzie Subs). Required for /api/v1/subtitles/search to return anything —
# without it the endpoint returns an empty list and the player's CC menu shows only "Off".
# Claim a free key: https://store.wyzie.io/redeem
WYZIE_API_KEY=wyzie_api_key_here

# Admin key for the destructive DELETE /api/v1/streams/cache/localhost endpoint.
# Sent as the `x-admin-key` header. Unset = endpoint refuses all callers.
ADMIN_API_KEY=change_me

# Default subtitle language hinted to the VidSrc embed's own player (ds_lang)
# VIDSRC_DEFAULT_SUB_LANG=en

# VidLink Customization
VIDLINK_PRIMARY_COLOR=e50914
VIDLINK_SECONDARY_COLOR=1f1f1f
VIDLINK_ICON_COLOR=ffffff
VIDLINK_ICONS=vid

# Scraper URLs (comma-separated, override defaults)
# VIDSRC_BASE_URLS=https://vidsrc-embed.ru,https://vidsrc-embed.su
# HNEMBED_BASE_URLS=https://hnembed.cc

# Puppeteer
# PUPPETEER_MAX_PAGES=6
# Pages opened at startup and kept warm (the rest are created on demand).
# PUPPETEER_PREWARM_PAGES=2
# Retire a page after this many scrapes so one renderer can't grow without bound.
# PUPPETEER_PAGE_MAX_USES=25
# Close extra pooled pages after this long unused (ms).
# PUPPETEER_IDLE_PAGE_TTL_MS=300000
# Restart Chrome when it (all its processes together) goes over this many MB.
# PUPPETEER_MAX_MEMORY_MB=1536
# Use an installed Chrome instead of Puppeteer's download.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Stream discovery timeout (ms)
# STREAM_TIMEOUT_MS=30000